{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git reset:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:docs.n8n.io)",
      "WebSearch",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:dev.to)",
      "Bash(test:*)",
      "Bash(npm run build:*)",
      "Bash(npm install)",
      "Bash(ls /home/torridfish/Code/LevDoom/.venv/lib/python*/site-packages/)",
      "Bash(ls /home/torridfish/Code/LevDoom/.venv/lib/python*/site-packages/levdoom/)",
      "Bash(ls /home/torridfish/Code/LevDoom/.venv/lib/python*/site-packages/levdoom/examples/)",
      "Bash(ls /home/torridfish/Code/LevDoom/.venv/lib/python*/site-packages/levdoom/envs/)",
      "Bash(.venv/bin/python test.py)",
      "Bash(wait)",
      "Bash(DISPLAY=:0 .venv/bin/python test.py)",
      "Bash(.venv/bin/pip list:*)",
      "Bash(.venv/bin/pip install:*)",
      "Bash(ls /home/torridfish/Code/LevDoom/.venv/bin/pip*)",
      "Bash(/home/torridfish/Code/LevDoom/.venv/bin/python -m pip install pynput -q)",
      "Bash(python3 -c \"import pynput; print\\(''ok''\\)\")",
      "Bash(python3 -c \"import keyboard; print\\(''ok''\\)\")",
      "Bash(python3 -m pip install pynput -q)",
      "Bash(sudo apt-get:*)",
      "Bash(/home/torridfish/Code/LevDoom/.venv/bin/python -m ensurepip)",
      "WebFetch(domain:api.github.com)",
      "Bash(ls -la /home/torridfish/Code/nav_hw2/*.json /home/torridfish/Code/nav_hw2/*.txt /home/torridfish/Code/nav_hw2/*.py)",
      "Bash(grep -E \"\\\\.\\(py|txt|json|yaml|yml|toml|cfg|ini|md\\)$\")",
      "Bash(find /home/torridfish/Code/nav_hw2 -name *.csv)",
      "Bash(ls -1 /home/torridfish/Code/nav_hw2/Simulation/*.py)",
      "Bash(pdflatex -interaction=nonstopmode main.tex)",
      "Bash(bibtex main:*)",
      "Bash(pdflatex -interaction=nonstopmode report.tex)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/torridfish/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/claude-hud/statusline.sh\""
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactEnabled": false
}
