{
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vllm1",
      "options": {
        "baseURL": "https://llm.torridfish.tech/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "GLM-5.3-Flash-EXL3": {
          "name": "GLM 5.3 Flash EXL3"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.13",
        "markitdown-mcp"
      ]
    },
    "websearch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "websearch-mcp"
      ],
      "environment": {
        "API_URL": "http://localhost:3001",
        "MAX_SEARCH_RESULT": "5"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}