ssh/.ssh/config
gh/.config/gh/hosts.yml
zsh/secrets.zsh
*.local

# Generated / cache files
.zcompdump*
*.zwc
*.log
node_modules/

# claude-hud writes its runtime data into the linked directory
claude/.claude/plugins/claude-hud/transcript-cursors/
